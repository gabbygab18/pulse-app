{
  "name": "pulse-tracker",
  "version": "1.0.9",
  "description": "Pulse — desktop time-tracking widget. Periodic screen capture and recording, uploaded to the Isla Portal while clocked in.",
  "main": "main.js",
  "author": "Isla",
  "license": "UNLICENSED",
  "scripts": {
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never",
    "dist:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:renderer && electron-builder --mac --publish never"
  },
  "dependencies": {
    "boxicons": "^2.1.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.isla.pulse",
    "productName": "Pulse",
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Pulse-win-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulse",
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "Pulse-linux-x64.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Pulse-mac.${ext}",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Pulse captures your screen periodically while you are clocked in, so your work hours can be verified in the Isla Portal."
      }
    }
  }
}
